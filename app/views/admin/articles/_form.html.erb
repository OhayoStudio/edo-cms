<%= form_with model: [:admin, article], class: "space-y-6" do |f| %>
  <% if article.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/20 border border-red-300 dark:border-red-700 rounded-lg p-4">
      <p class="text-sm font-medium text-red-800 dark:text-red-300 mb-2">
        <%= t("admin.common.errors_header", count: article.errors.count, model: t("admin.models.article")) %>
      </p>
      <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-400 space-y-1">
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= f.label :title, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :title, required: true, minlength: 5, maxlength: 200,
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100
                  #{article.errors[:title].any? ? 'border-red-400 focus:outline-red-500' : 'border-gray-300 dark:border-gray-600 focus:outline-sage-deep'}" %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :subtitle, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :subtitle,
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 focus:outline-sage-deep" %>
    </div>

    <div>
      <%= f.label :author_id, t("admin.articles.author"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.collection_select :author_id, Author.not_deleted.order(:first_name), :id, :display_name,
          { include_blank: t("admin.articles.select_author") },
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100
                  #{article.errors[:author_id].any? ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}" %>
    </div>

    <div>
      <%= f.label :category_id, t("admin.articles.category"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.collection_select :category_id, Category.not_deleted.order(:name), :id, :name,
          { include_blank: t("admin.articles.select_category") },
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100
                  #{article.errors[:category_id].any? ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}" %>
    </div>

    <div>
      <%= f.label :status, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :status, Article.statuses.keys.map { |s| [t("admin.article_status.#{s}", default: s.humanize), s] },
          { include_blank: false },
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600" %>
    </div>

    <div>
      <%= f.label :reading_time, t("admin.articles.reading_time"), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.number_field :reading_time, min: 1,
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 focus:outline-sage-deep" %>
      <p class="mt-1 text-xs text-gray-400"><%= t("admin.articles.auto_calc") %></p>
    </div>

    <div>
      <%= f.label :published_at, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.datetime_local_field :published_at,
          value: article.published_at&.strftime("%Y-%m-%dT%H:%M"),
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600" %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :excerpt, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_area :excerpt, rows: 3,
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 focus:outline-sage-deep" %>
      <p class="mt-1 text-xs text-gray-400"><%= t("admin.common.max_chars", n: 150) %></p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :content, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%# required: the editor blocks the submit while the body is blank (Lexxy checks it). %>
      <%= f.lexxy_rich_text_area :content, required: true %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :meta_description, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_area :meta_description, rows: 2,
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 focus:outline-sage-deep" %>
      <p class="mt-1 text-xs text-gray-400"><%= t("admin.common.max_chars", n: 160) %></p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :meta_keywords, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.text_field :meta_keywords,
          placeholder: t("admin.articles.meta_keywords_placeholder"),
          class: "block w-full rounded border px-3 py-2 text-sm bg-white dark:bg-ink-soft
                  text-gray-900 dark:text-gray-100 border-gray-300 dark:border-gray-600 focus:outline-sage-deep" %>
      <p class="mt-1 text-xs text-gray-400"><%= t("admin.articles.meta_keywords_hint") %></p>
    </div>

    <div data-controller="featured-image-drop"
         data-action="dragover->featured-image-drop#dragover dragleave->featured-image-drop#dragleave drop->featured-image-drop#drop"
         class="rounded border-2 border-dashed border-gray-200 dark:border-gray-600 p-3 transition-colors">
      <%= f.label :featured_image, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
      <% if stored_attachment?(article.featured_image) %>
        <img src="<%= url_for(article.featured_image.variant(resize_to_limit: [200, 120])) %>"
             data-featured-image-drop-target="preview"
             class="rounded border border-gray-200 dark:border-gray-600 mb-2" />
      <% else %>
        <img data-featured-image-drop-target="preview" class="rounded border border-gray-200 dark:border-gray-600 mb-2 hidden" src="" alt="" />
      <% end %>
      <p data-featured-image-drop-target="hint"
         class="text-xs text-gray-400 mb-2 <%= article.persisted? && article.featured_image.attached? ? 'hidden' : '' %>">
        <%= t("admin.articles.drop_image") %>
      </p>
      <%= f.file_field :featured_image, accept: "image/*",
          data: { featured_image_drop_target: "input" },
          class: "block w-full text-sm text-gray-500 dark:text-gray-400
                  file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0
                  file:text-xs file:bg-sage-deep file:text-white hover:file:bg-ink-soft" %>
    </div>

    <div class="flex items-center gap-2 pt-5">
      <%= f.check_box :featured, class: "rounded border-gray-300 text-sage-deep" %>
      <%= f.label :featured, t("admin.articles.featured"), class: "text-sm text-gray-700 dark:text-gray-300" %>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-2">
    <%= f.submit article.persisted? ? t("admin.articles.update") : t("admin.articles.create"),
        class: "px-5 py-2 bg-sage-deep hover:bg-ink-soft text-white rounded text-sm transition-colors cursor-pointer" %>
    <%= link_to t("admin.common.cancel"), admin_articles_path,
        class: "px-5 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300
                rounded text-sm hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" %>
  </div>

<% end %>
