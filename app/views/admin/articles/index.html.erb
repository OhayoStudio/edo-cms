<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-serif text-sage-deep dark:text-peach"><%= t("admin.articles.title") %></h1>
  <%= link_to t("admin.articles.new"), new_admin_article_path,
      class: "px-4 py-2 bg-sage-deep hover:bg-ink-soft text-white rounded text-sm transition-colors" %>
</div>

<div data-controller="frame-preview" data-action="keydown.esc@window->frame-preview#close">
<div class="bg-white dark:bg-ink rounded-lg shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-cream-soft dark:bg-ink-soft text-sage-deep dark:text-peach">
      <tr>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.title") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.articles.author") %></th>
        <th class="text-left px-4 py-3 font-semibold">
          <%= select_tag :category_id,
                options_from_collection_for_select(
                  [Struct.new(:id, :name).new("", t("admin.articles.all_categories"))] + @categories.to_a,
                  :id, :name,
                  params[:category_id].presence || ""
                ),
                onchange: "window.location = '#{admin_articles_path}?category_id=' + this.value",
                class: "text-xs font-semibold bg-transparent border-0 text-sage-deep dark:text-peach
                        cursor-pointer focus:outline-none pr-1 -ml-1" %>
        </th>
        <th class="text-left px-4 py-3 font-semibold">
          <%= select_tag :status,
                options_for_select(
                  [[t("admin.common.all_statuses"), ""], *Article.statuses.keys.map { |s| [t("admin.article_status.#{s}", default: s.humanize), s] }],
                  params[:status].presence || ""
                ),
                onchange: "window.location = '#{admin_articles_path}?category_id=#{params[:category_id]}&status=' + this.value",
                class: "text-xs font-semibold bg-transparent border-0 text-sage-deep dark:text-peach
                        cursor-pointer focus:outline-none pr-1 -ml-1" %>
        </th>
        <th class="text-center px-4 py-3 font-semibold"><%= t("admin.articles.priority") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.created") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.updated") %></th>
        <th class="text-right px-4 py-3 font-semibold"><%= t("admin.common.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <%= render partial: "article_row", collection: @articles, as: :article, locals: { categories: @categories } %>

      <% if @articles.empty? %>
        <tr>
          <td colspan="8" class="px-4 py-8 text-center text-gray-400 dark:text-gray-500">
            <%= t("admin.articles.empty") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div data-frame-preview-target="modal" data-action="click->frame-preview#closeOnBackdrop"
     role="dialog" aria-modal="true" aria-labelledby="article-preview-title"
     class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 p-4">
  <div class="bg-white dark:bg-ink text-gray-900 dark:text-gray-100 border border-rule dark:border-ink-soft rounded-lg shadow-xl w-full max-w-5xl h-[90vh] flex flex-col p-4">
    <div class="flex items-center justify-between gap-4 mb-3">
      <h2 id="article-preview-title" data-frame-preview-target="title"
          class="text-lg font-serif text-sage-deep dark:text-peach truncate"></h2>
      <div class="flex items-center gap-3 shrink-0">
        <a data-frame-preview-target="external" href="#" target="_blank" rel="noopener"
           class="text-xs text-gray-900 dark:text-gray-100 underline hover:opacity-80"><%= t("admin.articles.preview_new_tab") %></a>
        <button type="button" data-action="frame-preview#close" data-frame-preview-close
                aria-label="<%= t("admin.articles.preview_close") %>"
                class="text-gray-900 dark:text-gray-100 opacity-70 hover:opacity-100 text-2xl leading-none cursor-pointer">&times;</button>
      </div>
    </div>
    <iframe data-frame-preview-target="frame" src="about:blank"
            class="flex-1 w-full rounded border border-rule dark:border-ink-soft bg-white"></iframe>
  </div>
</div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @articles, params: { category_id: params[:category_id], status: params[:status] } %>
</div>

<script>
  document.addEventListener("keydown", function(e) {
    if (e.target.matches("input, textarea, [contenteditable]")) return
    if (document.querySelector("[data-frame-preview-target=modal]:not(.hidden)")) return
    if (e.key === "ArrowLeft")  document.querySelector("a[rel=prev]")?.click()
    if (e.key === "ArrowRight") document.querySelector("a[rel=next]")?.click()
  })
</script>

<%= render "admin/shared/confirm_modal" %>
