<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-serif text-sage-deep dark:text-peach"><%= t("admin.videos.title") %></h1>
  <%= link_to t("admin.videos.new"), new_admin_video_path,
      class: "px-4 py-2 bg-sage-deep hover:bg-ink-soft text-white rounded text-sm transition-colors" %>
</div>

<div data-controller="video-preview" data-action="keydown.esc@window->video-preview#close">
<div class="bg-white dark:bg-ink rounded-lg shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-cream-soft dark:bg-ink-soft text-sage-deep dark:text-peach">
      <tr>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.title") %></th>
        <th class="text-left px-4 py-3 font-semibold">
          <%= select_tag :status,
                options_for_select(
                  [[t("admin.common.all_statuses"), ""], [t("admin.common.published"), "published"], [t("admin.common.unpublished"), "unpublished"]],
                  params[:status].presence || ""
                ),
                onchange: "window.location = '#{admin_videos_path}?status=' + this.value",
                class: "text-xs font-semibold bg-transparent border-0 text-sage-deep dark:text-peach
                        cursor-pointer focus:outline-none pr-1 -ml-1" %>
        </th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.created") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.updated") %></th>
        <th class="text-right px-4 py-3 font-semibold"><%= t("admin.common.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @videos.each do |video| %>
        <tr id="video-row-<%= video.id %>" class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
          <td class="px-4 py-3 font-medium text-gray-900 dark:text-gray-100 max-w-xs">
            <% preview_data = { action: "video-preview#open", video_id: video.id, video_title: video.title } %>
            <div class="flex items-center gap-2 min-w-0">
              <button type="button" <%= tag.attributes(data: preview_data) %>
                      aria-label="<%= t("admin.videos.preview.play", title: video.title) %>"
                      title="<%= t("admin.videos.preview.open") %>"
                      class="shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full
                             bg-sage-deep text-white hover:bg-ink-soft transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 ml-0.5" aria-hidden="true">
                  <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14z"/>
                </svg>
              </button>
              <button type="button" <%= tag.attributes(data: preview_data) %>
                      class="truncate text-left text-gray-900 dark:text-gray-100 hover:underline cursor-pointer">
                <%= video.title %>
              </button>
            </div>
            <%= render "preview", video: video %>
          </td>
          <td class="px-4 py-3">
            <% published = video.story&.is_published %>
            <span class="px-2 py-0.5 rounded text-xs font-medium
              <%= published ? 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300'
                            : 'bg-peach-soft text-sage-deep dark:bg-sage-deep/40 dark:text-peach' %>">
              <%= published ? t("admin.common.published") : t("admin.common.unpublished") %>
            </span>
          </td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs whitespace-nowrap">
            <%= video.created_at.strftime("%b %-d, %Y") %>
          </td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs whitespace-nowrap">
            <%= video.updated_at.strftime("%b %-d, %Y") %>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-2">
              <%= link_to t("admin.common.edit"), edit_admin_video_path(video),
                  class: "px-2 py-1 text-xs border border-sage-deep text-sage-deep
                          dark:border-peach dark:text-peach rounded hover:bg-peach-tint
                          dark:hover:bg-sage-deep/20 transition-colors" %>

              <% if video.story&.is_published %>
                <%= button_to t("admin.common.unpublish"), unpublish_admin_video_path(video), method: :patch,
                    class: "px-2 py-1 text-xs border border-gray-400 text-gray-600
                            dark:border-gray-500 dark:text-gray-300 rounded hover:bg-gray-100
                            dark:hover:bg-gray-700 transition-colors cursor-pointer" %>
              <% else %>
                <%= button_to t("admin.common.publish"), publish_admin_video_path(video), method: :patch,
                    class: "px-2 py-1 text-xs bg-green-600 hover:bg-green-700 text-white rounded transition-colors cursor-pointer" %>
              <% end %>

              <button type="button"
                      class="px-2 py-1 text-xs bg-red-600 hover:bg-red-700 text-white rounded transition-colors cursor-pointer"
                      data-controller="admin-modal"
                      data-action="click->admin-modal#open"
                      data-admin-modal-url-value="<%= admin_video_path(video) %>"
                      data-admin-modal-title-value="<%= t("admin.common.delete_title", name: video.title) %>">
                <%= t("admin.common.delete") %>
              </button>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @videos.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-8 text-center text-gray-400 dark:text-gray-500">
            <%= t("admin.videos.empty") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div data-video-preview-target="modal" data-action="click->video-preview#closeOnBackdrop"
     role="dialog" aria-modal="true" aria-labelledby="video-preview-title"
     class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 p-4">
  <div class="bg-white dark:bg-ink text-gray-900 dark:text-gray-100 border border-rule dark:border-ink-soft rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-5">
    <div class="flex items-start justify-between gap-4 mb-4">
      <h2 id="video-preview-title" data-video-preview-target="title"
          class="text-lg font-serif text-sage-deep dark:text-peach break-words"></h2>
      <button type="button" data-action="video-preview#close" data-video-preview-close
              aria-label="<%= t("admin.videos.preview.close") %>"
              class="text-gray-900 dark:text-gray-100 opacity-70 hover:opacity-100 text-2xl leading-none cursor-pointer">&times;</button>
    </div>
    <div data-video-preview-target="body"></div>
  </div>
</div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @videos, params: { status: params[:status] } %>
</div>

<%= render "admin/shared/confirm_modal" %>
