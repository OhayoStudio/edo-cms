<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-serif text-sage-deep dark:text-peach"><%= t("admin.videos.title") %></h1>
  <%= link_to t("admin.videos.new"), new_admin_video_path,
      class: "px-4 py-2 bg-sage-deep hover:bg-ink-soft text-white rounded text-sm transition-colors" %>
</div>

<div data-controller="video-preview" data-action="keydown.esc@window->video-preview#close">
<div class="bg-white dark:bg-ink rounded-lg shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-cream-soft dark:bg-ink-soft text-sage-deep dark:text-peach">
      <tr>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.title") %></th>
        <th class="text-left px-4 py-3 font-semibold">
          <%= select_tag :status,
                options_for_select(
                  [[t("admin.common.all_statuses"), ""], [t("admin.common.published"), "published"], [t("admin.common.unpublished"), "unpublished"]],
                  params[:status].presence || ""
                ),
                onchange: "window.location = '#{admin_videos_path}?status=' + this.value",
                class: "text-xs font-semibold bg-transparent border-0 text-sage-deep dark:text-peach
                        cursor-pointer focus:outline-none pr-1 -ml-1" %>
        </th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.created") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.updated") %></th>
        <th class="text-right px-4 py-3 font-semibold"><%= t("admin.common.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <%= render partial: "video_row", collection: @videos, as: :video %>

      <% if @videos.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-8 text-center text-gray-400 dark:text-gray-500">
            <%= t("admin.videos.empty") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div data-video-preview-target="modal" data-action="click->video-preview#closeOnBackdrop"
     role="dialog" aria-modal="true" aria-labelledby="video-preview-title"
     class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 p-4">
  <div class="bg-white dark:bg-ink text-gray-900 dark:text-gray-100 border border-rule dark:border-ink-soft rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-5">
    <div class="flex items-start justify-between gap-4 mb-4">
      <h2 id="video-preview-title" data-video-preview-target="title"
          class="text-lg font-serif text-sage-deep dark:text-peach break-words"></h2>
      <button type="button" data-action="video-preview#close" data-video-preview-close
              aria-label="<%= t("admin.videos.preview.close") %>"
              class="text-gray-900 dark:text-gray-100 opacity-70 hover:opacity-100 text-2xl leading-none cursor-pointer">&times;</button>
    </div>
    <div data-video-preview-target="body"></div>
  </div>
</div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @videos, params: { status: params[:status] } %>
</div>

<%= render "admin/shared/confirm_modal" %>
