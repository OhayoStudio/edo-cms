<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-serif text-sage-deep dark:text-peach"><%= t("admin.tags.title") %></h1>
  <%= link_to t("admin.tags.new"), new_admin_tag_path,
      class: "px-4 py-2 bg-sage-deep hover:bg-ink-soft text-white rounded text-sm transition-colors" %>
</div>

<div class="bg-white dark:bg-ink rounded-lg shadow overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-cream-soft dark:bg-ink-soft text-sage-deep dark:text-peach">
      <tr>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.name") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.tags.articles") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.status") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.created") %></th>
        <th class="text-left px-4 py-3 font-semibold"><%= t("admin.common.updated") %></th>
        <th class="text-right px-4 py-3 font-semibold"><%= t("admin.common.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @tags.each do |tag| %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
          <td class="px-4 py-3 font-medium text-gray-900 dark:text-gray-100">
            <%= tag.name %>
          </td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">
            <%= tag.article_count %>
          </td>
          <td class="px-4 py-3">
            <% if tag.featured? %>
              <span class="px-2 py-0.5 rounded text-xs font-medium bg-peach-soft text-sage-deep dark:bg-sage-deep/40 dark:text-peach">
                <%= t("admin.tags.featured_badge") %>
              </span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs whitespace-nowrap">
            <%= tag.created_at.strftime("%b %-d, %Y") %>
          </td>
          <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs whitespace-nowrap">
            <%= tag.updated_at.strftime("%b %-d, %Y") %>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-2">
              <%= admin_edit_icon_link(edit_admin_tag_path(tag), name: tag.name) %>

              <%= admin_delete_icon_button(url: admin_tag_path(tag), confirm_title: t("admin.common.delete_title", name: tag.name), name: tag.name) %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @tags.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-8 text-center text-gray-400 dark:text-gray-500">
            <%= t("admin.tags.empty") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @tags %>
</div>

<%= render "admin/shared/confirm_modal" %>
